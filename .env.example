# ==============================================================================
# Natesa Jewellery Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required for database & admin credentials)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. Cloudinary Media CDN (Required for product and category image hosting)
# ------------------------------------------------------------------------------
# In Cloudinary: Dashboard / Console -> Account Details
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# 3. Optional Application Settings
# ------------------------------------------------------------------------------
PORT="3000"
APP_URL="http://localhost:3000"
